{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/register/:code",
      "destination": "/api/register.js?code=:code"
    },
    {
      "source": "/api/register",
      "destination": "/api/register.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|downloads).*)",
      "destination": "/index.html"
    }
  ]
}
